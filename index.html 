: 15px; font-weight: 700; border: 2px solid #1A6E8E; border-radius: 2px; cursor: pointer; background: transparent; color: #1A6E8E; }\n    .btn:hover { background: #eaf1f8; }\n    .btn-primary { background: #1A6E8E; color: #ffffff; }\n    .btn-primary:hover { background: #0d3f6e; border-color: #0d3f6e; }\n    .btn-ghost { border-color: transparent; }\n    .btn:focus-visible { outline: 2px solid #1A6E8E; outline-offset: 2px; }\n    .table td { border-bottom: 1px solid #dde4e1; }\n    .pg-wrap { --pgx: 40px; --pgy: 48px; }\n    @media (max-width: 980px) {\n      .pg-wrap { --pgx: 24px; --pgy: 28px; }\n      .main-grid { grid-template-columns: minmax(0,1fr) !important; gap: 48px !important; }\n      .card-aside { position: static !important; }\n      .pg-title { font-size: 42px !important; }\n    }\n    @media (max-width: 600px) {\n      .pg-wrap { --pgx: 16px; --pgy: 20px; }\n      .pg-title { font-size: 31px !important; }\n      .stats-grid { grid-template-columns: repeat(2, minmax(0,1fr)) !important; gap: 10px 20px !important; }\n      .card-btn { min-width: 0 !important; width: 100% !important; }\n      .dlg-wrap { padding: 0 !important; }\n      .dlg { padding: 24px 18px 40px !important; border-radius: 0 !important; }\n      .dlg h2 { font-size: 26px !important; }\n      .dlg-grid { grid-template-columns: 1fr !important; gap: 18px !important; }\n    }\n  <\u002Fstyle>\n<\u002Fhelmet>\n\n\n\n<div class=\"pg-wrap\" style=\"max-width:1280px;margin:0 auto;padding:var(--pgy) var(--pgx) 96px\">\n  <div style=\"background:#1a1a1a;color:#ffffff;margin:calc(-1 * var(--pgy)) calc(-1 * var(--pgx)) 0;padding:8px var(--pgx);display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px;font-family:'Montserrat', sans-serif;font-size:12.5px\">\n    <svg width=\"21\" height=\"14\" sc-camel-view-box=\"0 0 21 14\" aria-hidden=\"true\"><rect width=\"21\" height=\"14\" fill=\"#B50027\"><\u002Frect><rect y=\"4.67\" width=\"21\" height=\"4.67\" fill=\"#ffffff\"><\u002Frect><rect width=\"8\" height=\"9.33\" fill=\"#002D56\"><\u002Frect><circle cx=\"4\" cy=\"4.67\" r=\"2.6\" fill=\"none\" stroke=\"#EED000\" stroke-width=\"0.8\"><\u002Fcircle><\u002Fsvg>\n    <span>A demonstration in the style of an official website of the State of Georgia.<\u002Fspan>\n    <span style=\"color:#9ad1e0\">This is a prototype, not a state site.<\u002Fspan>\n  <\u002Fdiv>\n  <div style=\"margin:0 calc(-1 * var(--pgx)) 32px;padding:14px var(--pgx);border-bottom:1px solid #d5dade;display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;background:#ffffff\">\n    <span style=\"font-family:'Source Serif 4', Georgia, serif;font-size:22px;font-weight:600;color:#002D56\">Georgia Technology Authority<\u002Fspan>\n    <span style=\"font-family:'Montserrat', sans-serif;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#5a5f5e;border-left:1px solid #d5dade;padding-left:14px\">Enterprise AI Responsible Use Policy<\u002Fspan>\n    <span style=\"flex:1\"><\u002Fspan>\n    <span style=\"background:#D4A017;color:#1a1a1a;font-family:'Montserrat', sans-serif;font-size:12px;font-weight:700;padding:3px 12px;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap;border-radius:2px\">Example Demo<\u002Fspan>\n  <\u002Fdiv>\n\n  <header style=\"margin-bottom:40px\">\n\n    <h1 class=\"pg-title\" style=\"font-family:'Source Serif 4', Georgia, serif;font-size:56px;line-height:1.05;margin:28px 0 12px;font-weight:700\">Policy Amendments &amp; Updates<\u002Fh1>\n    <p style=\"font-size:15px;letter-spacing:.06em;text-transform:uppercase;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;color:#5a5f5e;margin:0 0 16px\">A preview of GTA's AI policy as it could read with the policy cards from our gap analysis integrated<\u002Fp>\n    <div class=\"stats-grid\" style=\"border-top:1px solid #c9d3d1;margin:0 0 20px;padding-top:18px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px 40px;max-width:900px\">\n      <div style=\"display:flex;align-items:baseline;gap:12px\"><span style=\"font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:22px;font-weight:700;color:#003039\">2<\u002Fspan><span style=\"font-size:15px;color:#5a5f5e\">Scope &amp; definitions<\u002Fspan><\u002Fdiv>\n      <div style=\"display:flex;align-items:baseline;gap:12px\"><span style=\"font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:22px;font-weight:700;color:#003039\">3<\u002Fspan><span style=\"font-size:15px;color:#5a5f5e\">Transparency &amp; resident rights<\u002Fspan><\u002Fdiv>\n      <div style=\"display:flex;align-items:baseline;gap:12px\"><span style=\"font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:22px;font-weight:700;color:#003039\">2<\u002Fspan><span style=\"font-size:15px;color:#5a5f5e\">Human oversight &amp; testing<\u002Fspan><\u002Fdiv>\n      <div style=\"display:flex;align-items:baseline;gap:12px\"><span style=\"font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:22px;font-weight:700;color:#003039\">2<\u002Fspan><span style=\"font-size:15px;color:#5a5f5e\">Agentic AI safeguards<\u002Fspan><\u002Fdiv>\n      <div style=\"display:flex;align-items:baseline;gap:12px\"><span style=\"font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:22px;font-weight:700;color:#003039\">2<\u002Fspan><span style=\"font-size:15px;color:#5a5f5e\">Records &amp; data protection<\u002Fspan><\u002Fdiv>\n      <div style=\"display:flex;align-items:baseline;gap:12px\"><span style=\"font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:22px;font-weight:700;color:#003039\">1<\u002Fspan><span style=\"font-size:15px;color:#5a5f5e\">Vendors &amp; contracts<\u002Fspan><\u002Fdiv>\n    <\u002Fdiv>\n    <p style=\"font-size:19px;line-height:1.55;margin:0\">The suggested language from all twelve policy cards is embedded directly into the policy text below, as a marked-up draft. <span style=\"color:#B01116;text-decoration:line-through\">Struck red text<\u002Fspan> is removed; <span style=\"color:#08473D\">green text<\u002Fspan> is added. Click any <span style=\"border:1px solid #9cb9d6;padding:1px 6px;font-size:13px;color:#1A6E8E\">Card N<\u002Fspan> tag to open the full amendment card.<\u002Fp>\n    <div style=\"border-top:1px solid #c9d3d1;margin-top:24px\"><\u002Fdiv>\n  <\u002Fheader>\n\n  <div class=\"main-grid\" style=\"display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:56px;align-items:start\">\n\n    <main>\n      <div style=\"display:flex;gap:12px;margin-bottom:12px;flex-wrap:wrap\">\n        <button class=\"{{ psCls }}\" sc-camel-on-click=\"{{ showPS }}\">PS-23-001 · Policy<\u002Fbutton>\n        <button class=\"{{ ssCls }}\" sc-camel-on-click=\"{{ showSS }}\">SS-23-002 · Standard<\u002Fbutton>\n        <span style=\"flex:1\"><\u002Fspan>\n        <button class=\"{{ rlCls }}\" sc-camel-on-click=\"{{ showRedline }}\">Redline<\u002Fbutton>\n        <button class=\"{{ clCls }}\" sc-camel-on-click=\"{{ showClean }}\">Clean (as amended)<\u002Fbutton>\n      <\u002Fdiv>\n      <div style=\"display:flex;gap:20px;margin-bottom:8px\">\n        <button sc-camel-on-click=\"{{ exportEdits }}\" style=\"border:none;background:transparent;font-family:'Montserrat', sans-serif;font-size:13px;color:#1A6E8E;cursor:pointer;padding:0;text-decoration:underline\">Export my edits<\u002Fbutton>\n        <button sc-camel-on-click=\"{{ importEdits }}\" style=\"border:none;background:transparent;font-family:'Montserrat', sans-serif;font-size:13px;color:#1A6E8E;cursor:pointer;padding:0;text-decoration:underline\">Import a colleague's edits<\u002Fbutton>\n      <\u002Fdiv>\n      <p style=\"font-size:13px;font-style:italic;color:#5a5f5e;margin:0 0 32px\">Redline shows every edit against the current text. All of the current edits are for demo and are required to be reviewed by a human prior to adoption.<\u002Fp>\n\n      <sc-if value=\"{{ isPS }}\" hint-placeholder-val=\"{{ true }}\">\n      <article data-screen-label=\"PS-23-001 redline\" style=\"max-width:70ch\">\n        <p style=\"font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#5a5f5e;margin:0 0 8px\">Enterprise Policy · Issued 10/5/2023 · amended by card 1<\u002Fp>\n        <h2 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:34px;line-height:1.15;margin:0 0 24px\">Enterprise Artificial Intelligence Responsible Use (PS-23-001)<\u002Fh2>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">Purpose<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\">As Artificial Intelligence (AI) technology continues to advance and become an integral part of everyday business operations, it is increasingly important for the state to establish clear AI usage policies. This policy is designed to promote the acceptable use of AI tools, while also minimizing the potential for intentional or unintentional misuse, unethical outcomes, potential biases, use of sensitive data, and information security breaches.<\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">Scope and Authority<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\">O.C.G.A 50-25-4(a)(8), (a)(20), (a)(28), State Government, Georgia Technology, General Powers · PM-04-001, Information Technology Policies, Standards and Guidelines · PS-08-005, Enterprise Information Security Policy.<\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">Terms and Definitions<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\"><strong>Agency:<\u002Fstrong> every state department, agency, board, bureau, commission, and authority, excluding the judicial and legislative branches, the Georgia Department of Defense, departments headed by elected constitutional officers, and the University System of Georgia.<\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\"><button class=\"card-btn\" sc-camel-on-click=\"{{ open1 }}\" style=\"display:block;min-width:340px;width:fit-content;margin:0 auto 14px;border:2px solid #1A6E8E;background:#ffffff;color:#1A6E8E;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:15px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:10px 32px;cursor:pointer;border-radius:2px;box-shadow:0 2px 6px rgba(0,48,57,.15);text-align:center\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">Card 1 {{ stat1 }}<\u002Fbutton><span style=\"{{ delStyle }}\"><strong>Artificial Intelligence:<\u002Fstrong> tools or systems used to create models that can generate new and original content, such as images, music, or text, based on patterns and examples from existing data. <\u002Fspan><span style=\"{{ insStyle }}\"><strong>Artificial Intelligence (AI):<\u002Fstrong> a machine-based system that, for a given set of human-defined objectives, makes predictions, recommendations or decisions influencing real or virtual environments. AI includes, without limitation, systems that classify, score, rank, prioritise, match, route, detect, forecast, or generate content. AI does not include a deterministic rule engine whose rules are wholly authored and maintained by identified persons, a spreadsheet formula, or statistical reporting that produces no output about an identified individual.<\u002Fspan><\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\"><span style=\"{{ insStyle }}\"><strong>Generative AI (GenAI):<\u002Fstrong> tools or systems used to create models that can generate new and original content, such as images, music, or text, based on patterns and examples from existing data. Generative AI is a subset of AI.<\u002Fspan><\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\"><span style=\"{{ insStyle }}\"><strong>AI System:<\u002Fstrong> any software, tool, platform or service that uses AI to perform a task or produce an output, including a product in which AI is a feature rather than the whole.<\u002Fspan><\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\"><strong>Technology Resources:<\u002Fstrong> hardware, software, and communications equipment, including personal computers, mainframes, networks, servers, mobile devices, peripheral equipment, telephones, wireless communications, public safety radio services, facsimile machines, technology facilities, and other relevant hardware and software items as well as personnel tasked with the planning, implementation, and support of technology.<\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">Policy<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\"><button class=\"card-btn\" sc-camel-on-click=\"{{ open1 }}\" style=\"display:block;min-width:340px;width:fit-content;margin:0 auto 14px;border:2px solid #1A6E8E;background:#ffffff;color:#1A6E8E;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:15px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:10px 32px;cursor:pointer;border-radius:2px;box-shadow:0 2px 6px rgba(0,48,57,.15);text-align:center\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">Card 1 {{ stat1 }}<\u002Fbutton><span style=\"{{ delStyle }}\">Agencies shall submit all software, applications, tools, and services utilizing AI for business operations to GTA for review prior to procurement. <\u002Fspan><span style=\"{{ insStyle }}\">(1) An agency shall submit every AI System proposed for use in business operations to GTA for review before procurement, before renewal, and before any material change in the system's purpose, data inputs or degree of autonomy. Submission is required whether the AI is the whole of the product or a feature of it, whether the AI is generative or not, and whether the system is acquired, licensed, obtained at no cost, or built by the agency. <\u002Fspan><span style=\"{{ insStyle }}\">(2) <\u002Fspan>All agencies shall follow established State policies and standards to implement technology resources using AI.<\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">Related Enterprise Policies, Standards, and Guidelines<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\">Artificial Intelligence Responsible Use — SS-23-002 · Artificial Intelligence Responsible Use Guidelines — GS-23-001.<\u002Fp>\n      <\u002Farticle>\n      <\u002Fsc-if>\n\n      <sc-if value=\"{{ isSS }}\" hint-placeholder-val=\"{{ false }}\">\n      <article data-screen-label=\"SS-23-002 redline\" style=\"max-width:70ch\">\n        <p style=\"font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#5a5f5e;margin:0 0 8px\">Enterprise Standard · Issued 12/12/2023 · amended by cards 2–12<\u002Fp>\n        <h2 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:34px;line-height:1.15;margin:0 0 12px\">Artificial Intelligence Responsible Use (SS-23-002)<\u002Fh2>\n        <p style=\"font-size:14px;font-style:italic;color:#5a5f5e;margin:0 0 24px\">Provisions carrying amendments are shown in full; some long sub-lists are abridged for this prototype.<\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">Terms and Definitions<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\"><strong>Artificial Intelligence:<\u002Fstrong> a machine-based system that can, for a given set of human-defined objectives, make predictions, recommendations or decisions influencing real or virtual environments.<\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\"><strong>Generative AI:<\u002Fstrong> tools or systems used to create models that can generate new and original content, such as images, music, or text, based on patterns and examples from existing data.<\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\"><strong>Deep learning:<\u002Fstrong> model, tool or system used to recognize complex patterns in pictures, text, sounds, and other data to produce insights and predictions.<\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\"><strong>Machine learning:<\u002Fstrong> computer systems or tools that are able to learn and adapt without following explicit instructions, by using algorithms and statistical models to analyze and draw inferences from patterns in data.<\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\"><button class=\"card-btn\" sc-camel-on-click=\"{{ open2 }}\" style=\"display:block;min-width:340px;width:fit-content;margin:0 auto 14px;border:2px solid #1A6E8E;background:#ffffff;color:#1A6E8E;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:15px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:10px 32px;cursor:pointer;border-radius:2px;box-shadow:0 2px 6px rgba(0,48,57,.15);text-align:center\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">Card 2 {{ stat2 }}<\u002Fbutton><span style=\"{{ insBlockStyle }}\">{{ docPro2 }}<\u002Fspan><\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">1. Responsible Use of AI Tools within Agencies<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\">Agencies shall: (a) use AI tools only for their intended purpose and in accordance with any applicable laws and regulations; (b) ensure that AI tools are used in a manner consistent with the mission, values, and business objectives of the agency; (c) exercise due diligence and critical thinking when using AI-generated outputs and guard against intentional and unintentional misuse of AI;<\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\"><button class=\"card-btn\" sc-camel-on-click=\"{{ open4 }}\" style=\"display:block;min-width:340px;width:fit-content;margin:0 auto 14px;border:2px solid #1A6E8E;background:#ffffff;color:#1A6E8E;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:15px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:10px 32px;cursor:pointer;border-radius:2px;box-shadow:0 2px 6px rgba(0,48,57,.15);text-align:center\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">Card 4 {{ stat4 }}<\u002Fbutton><span style=\"{{ delStyle }}\">(d) report all tools using AI components to GTA via email at gta.psg@gta.ga.gov. <\u002Fspan><span style=\"{{ insStyle }}\">(d) record every AI System used or planned in the AI inventory maintained under paragraph (e), and keep the record current.<\u002Fspan><\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\"><span style=\"{{ insStyle }}\">(e) AI inventory. The Director of the GTA Office of Artificial Intelligence is the custodian of the enterprise AI inventory. An agency shall create an inventory record within thirty days of approval of an AI System under PS-23-001, and shall update it within thirty days of a material change or of decommissioning. Each record shall state: system name; agency and business owner by position; vendor and product; whether the system is generative, predictive, or authorised for agentic operation under §14; whether it supports a consequential determination under §13; the classes of data processed; each sectoral regime identified under §6(e); the Business Solutions Review reference; the date of the most recent pre-deployment evaluation under §9(f); the date of the most recent independent evaluation under PS-23-001(3); deployment status; the human review provision relied on under §5(h); accessibility conformance status under §5(k); and the retention classification under SS-25-001 §1.7. The custodian shall reconcile the inventory against Business Solutions Review records and against enterprise procurement data each quarter and shall report unreconciled items to the State CIO. The custodian shall publish a statewide AI catalogue annually, withholding only material exempt from disclosure under the Georgia Open Records Act and identifying each withholding by field and ground.<\u002Fspan><\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">2. All entities other than an Agency<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\">Non-agency entities shall disclose how their products undergo testing for safety, accuracy and reliability; agree to review for ethical, legal, and societal implications; submit an AI development plan for ongoing monitoring and maintenance; and report all tools using AI components to GTA.<\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">3. Procuring AI Solutions<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\">Agencies shall submit a Business Solutions Review (BSR) Request form to GTA prior to procurement. GTA will assess the tool for safety, privacy, and compliance. Service and technology contracts shall provide standards of third-party providers and their partners or subcontractors, including: (a) adhering to GTA Policies, Standards and Guidelines;<\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\"><button class=\"card-btn\" sc-camel-on-click=\"{{ open5 }}\" style=\"display:block;min-width:340px;width:fit-content;margin:0 auto 14px;border:2px solid #1A6E8E;background:#ffffff;color:#1A6E8E;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:15px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:10px 32px;cursor:pointer;border-radius:2px;box-shadow:0 2px 6px rgba(0,48,57,.15);text-align:center\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">Card 5 {{ stat5 }}<\u002Fbutton><span style=\"{{ delStyle }}\">(b) adhering to NIST guidance, risk management frameworks and standards for responsible artificial intelligence practices. <\u002Fspan><span style=\"{{ insStyle }}\">(b) adhering to NIST AI 100-1, Artificial Intelligence Risk Management Framework (AI RMF 1.0), and, for any generative AI component, NIST AI 600-1, Generative AI Profile. Adherence is evidenced by a written mapping, current as at the proposal date, of the contractor's practices to each of the four functions of AI RMF 1.0 — Govern, Map, Measure and Manage — accompanied by: the system or model documentation relied on; the results of the contractor's most recent internal evaluation of the system, including any red-team or adversarial testing; the results of any third-party assessment; and a statement of known limitations and unsupported uses. A proposal that does not include the mapping and the accompanying items shall be scored as non-responsive on this criterion. Where the contractor cannot produce an item, it shall state so expressly and give the reason; a stated absence is scoreable, an omission is not.<\u002Fspan><\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\">(c) providing copies of the Contractors' and Subcontractors' framework and policies concerning Responsible AI <em>(detailed subclauses i–iii abridged here — see the published standard)<\u002Fem>.<\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\"><span style=\"{{ insStyle }}\">(d) Contract mechanism. The duties stated in §2 and §3 bind a contractor only through contract. The Deputy Commissioner of the State Purchasing Division shall include the clauses at Annex A of this Standard in every solicitation for an AI System, in every statewide contract for an AI System, and in every renewal or amendment of such a contract executed after the effective date of this paragraph. An agency entering an agreement for an AI System outside a statewide contract shall include the Annex A clauses in that agreement. An agency shall not execute an agreement for an AI System that omits the Annex A clauses without the written approval of the State CIO, which shall state the ground.<\u002Fspan><\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">4. Identifying and Mitigating Bias in AI-generated Outputs<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\">Agencies shall: (a) be aware of common biases that may be present in AI systems, such as data bias, algorithmic bias and confirmation bias; (b) regularly review and evaluate AI-generated outputs for potential biases and inaccuracies, seeking input from diverse perspectives and stakeholder groups; (c) use AI tools with transparent methodologies and documentation; (d) collaborate with AI vendors and developers to improve AI systems and address identified biases.<\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\"><button class=\"card-btn\" sc-camel-on-click=\"{{ open6 }}\" style=\"display:block;min-width:340px;width:fit-content;margin:0 auto 14px;border:2px solid #1A6E8E;background:#ffffff;color:#1A6E8E;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:15px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:10px 32px;cursor:pointer;border-radius:2px;box-shadow:0 2px 6px rgba(0,48,57,.15);text-align:center\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">Card 6 {{ stat6 }}<\u002Fbutton><span style=\"{{ insBlockStyle }}\">{{ docPro6 }}<\u002Fspan><\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">5. Ensuring Accuracy and Appropriateness of AI-generated Outputs<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\">Agencies shall verify accuracy against reliable sources and human judgment; review outputs for appropriateness in context; establish checks and balances involving multiple reviewers; ensure AI-generated content is reviewed and approved by the business owner before publication or decision-making; develop guidelines for responsible use in different contexts; be aware of risks such as hallucinations, prompt injections, and copyright infringement; and maintain a record of AI tool usage including purpose, inputs, outputs, and actions taken <em>(sub-paragraphs (a)–(g) abridged)<\u002Fem>.<\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\"><button class=\"card-btn\" sc-camel-on-click=\"{{ open8 }}\" style=\"display:block;min-width:340px;width:fit-content;margin:0 auto 14px;border:2px solid #1A6E8E;background:#ffffff;color:#1A6E8E;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:15px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:10px 32px;cursor:pointer;border-radius:2px;box-shadow:0 2px 6px rgba(0,48,57,.15);text-align:center\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">Card 8 {{ stat8 }}<\u002Fbutton><span style=\"{{ insBlockStyle }}\">{{ docPro8 }}<\u002Fspan><\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">6. Data Protection, Safety and Privacy<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\">Agencies shall adhere to the Enterprise's Data Protection Policies, Standards and Guidelines (SS-08-003; SS-15-002) when using AI systems. This includes:<\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 12px\"><button class=\"card-btn\" sc-camel-on-click=\"{{ open9 }}\" style=\"display:block;min-width:340px;width:fit-content;margin:0 auto 14px;border:2px solid #1A6E8E;background:#ffffff;color:#1A6E8E;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:15px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:10px 32px;cursor:pointer;border-radius:2px;box-shadow:0 2px 6px rgba(0,48,57,.15);text-align:center\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">Card 9 {{ stat9 }}<\u002Fbutton><span style=\"{{ delStyle }}\">(a) ensuring that all confidential information or sensitive and personal data must be authorized by appropriate agency authority for use in the manner proposed and, when used, is anonymized, encrypted, or otherwise protected when used with AI tools. <\u002Fspan><span style=\"{{ insBlockStyle }}\"><strong>(a) Protection of data used with AI Systems.<\u002Fstrong> Use of confidential, sensitive or personal data with an AI System shall be authorised in advance by the agency's Data Protection Officer for the use proposed, and shall be protected as follows.\n\n<strong>(i) At rest and in transit.<\u002Fstrong> Encrypted in accordance with SS-08-003 and PS-08-005.\n\n<strong>(ii) As prompt or inference input.<\u002Fstrong> Limited to the data fields necessary to the task; pseudonymised in any field not required for the determination to be made; and covered by a contract term prohibiting the vendor from retaining the input beyond the session or using it to train or improve a model, as provided in Annex A clause A.3.\n\n<strong>(iii) As inferred attribute.<\u002Fstrong> An attribute the system infers about an identified individual, and which was not supplied as input, shall be classified and protected as data of the same class as the attribute inferred, and its generation shall be recorded in the AI inventory record.\n\n<strong>(iv) De-identification.<\u002Fstrong> Data is not de-identified for the purposes of this Standard where the agency could re-identify the individual using other data reasonably available to it; removal of direct identifiers alone does not satisfy this paragraph.<\u002Fspan><\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\">(b) implementing sufficient security measures to protect data from unauthorized access, modification, or deletion; (c) obtaining appropriate consent from data subjects when necessary; (d) reporting any data breaches or incidents involving AI systems to the designated Data Protection Officer.<\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">7. Training and Awareness<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\">All users of AI systems shall undergo appropriate training, including familiarization with this AI Usage Policy and participation in regular training sessions and workshops.<\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">8. Reporting Misuse<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\">Each agency shall designate a staff member responsible for compliance. Agencies shall report suspected misuse of AI systems — intentional (AI-based fraud, discrimination, invasion of privacy, malicious use, spreading misinformation) or unintentional (bias, privacy violations, inaccurate information, inappropriate content, over-reliance on AI) — to the agency CIO or senior executive and GTA OIS.<\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">9. AI Development and External Collaboration<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\">Collaboration agreements must disclose the manner and use of AI technology and define roles, responsibilities and ownership. Development shall prioritize safety, privacy, and ethics; address potential biases; include rigorous pre-deployment testing and a plan for ongoing monitoring; and report risks or ethical concerns to the agency's Ethics Officer, CIO, and State CIO.<\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">10. Termination and Business Continuity<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\">The State CIO or GTA OIS may order the termination of use of any AI tool found to generate outputs that risk data privacy and security, reputational damage, or malicious consequences. Agencies shall maintain a contingency plan under SS-08-045.<\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">11. Violations<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\"><button class=\"card-btn\" sc-camel-on-click=\"{{ open10 }}\" style=\"display:block;min-width:340px;width:fit-content;margin:0 auto 14px;border:2px solid #1A6E8E;background:#ffffff;color:#1A6E8E;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:15px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:10px 32px;cursor:pointer;border-radius:2px;box-shadow:0 2px 6px rgba(0,48,57,.15);text-align:center\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">Card 10 {{ stat10 }}<\u002Fbutton>Any state employee, contractor, or vendor found to violate this standard will be subject to disciplinary action, including but not limited to, termination of employment, contract, or agreement. <span style=\"{{ insStyle }}\">An employee who discloses their own use of an AI System, or who reports a suspected violation of this Standard or an AI incident under §8(c), shall not be subject to disciplinary action, or to any adverse change in duties, assignment or evaluation, on account of the disclosure or report, where the disclosure or report was made in good faith and promptly. Prompt good-faith disclosure shall be a mitigating factor in any disciplinary determination concerning the conduct disclosed. This paragraph does not protect a person who concealed the conduct, who disclosed it only after an inquiry had commenced, or whose conduct caused harm that prompt disclosure would have avoided. An employee who believes they have been subject to action prohibited by this paragraph may report it to the individual designated as Ethics Officer under PS-23-001(4) and to the State CIO, and this paragraph is in addition to any protection afforded by law.<\u002Fspan><\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:36px 0 10px\">12. Audit and Monitoring<\u002Fh3>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\">Agencies shall maintain and make available to GTA upon request, records of the agency's AI tool monitoring efforts. GTA shall conduct an audit of all AI tools determined to be out of compliance with this Standard.<\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:48px 0 6px;color:#08473D\">13. Resident notice, contestability and re-determination <span style=\"font-size:13px;letter-spacing:.1em;text-transform:uppercase;font-weight:400\">— new section, two alternate drafts<\u002Fspan><\u002Fh3>\n        <p style=\"font-size:14px;font-style:italic;color:#5a5f5e;margin:0 0 16px\">Cards 3 and 11 each draft §13. Review both and adopt one, or merge them.<\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 16px\"><button class=\"card-btn\" sc-camel-on-click=\"{{ open3 }}\" style=\"display:block;min-width:340px;width:fit-content;margin:0 auto 14px;border:2px solid #1A6E8E;background:#ffffff;color:#1A6E8E;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:15px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:10px 32px;cursor:pointer;border-radius:2px;box-shadow:0 2px 6px rgba(0,48,57,.15);text-align:center\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">Card 3 · Draft A {{ stat3 }}<\u002Fbutton><span style=\"{{ insBlockStyle }}\">{{ docPro3 }}<\u002Fspan><\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\"><button class=\"card-btn\" sc-camel-on-click=\"{{ open11 }}\" style=\"display:block;min-width:340px;width:fit-content;margin:0 auto 14px;border:2px solid #1A6E8E;background:#ffffff;color:#1A6E8E;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:15px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:10px 32px;cursor:pointer;border-radius:2px;box-shadow:0 2px 6px rgba(0,48,57,.15);text-align:center\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">Card 11 · Draft B {{ stat11 }}<\u002Fbutton><span style=\"{{ insBlockStyle }}\">{{ docPro11 }}<\u002Fspan><\u002Fp>\n\n        <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:21px;margin:48px 0 6px;color:#08473D\">14. Agentic operation <span style=\"font-size:13px;letter-spacing:.1em;text-transform:uppercase;font-weight:400\">— new section, two alternate drafts<\u002Fspan><\u002Fh3>\n        <p style=\"font-size:14px;font-style:italic;color:#5a5f5e;margin:0 0 16px\">Cards 7 and 12 each draft §14. Review both and adopt one, or merge them.<\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0 0 16px\"><button class=\"card-btn\" sc-camel-on-click=\"{{ open7 }}\" style=\"display:block;min-width:340px;width:fit-content;margin:0 auto 14px;border:2px solid #1A6E8E;background:#ffffff;color:#1A6E8E;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:15px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:10px 32px;cursor:pointer;border-radius:2px;box-shadow:0 2px 6px rgba(0,48,57,.15);text-align:center\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">Card 7 · Draft A {{ stat7 }}<\u002Fbutton><span style=\"{{ insBlockStyle }}\">{{ docPro7 }}<\u002Fspan><\u002Fp>\n        <p style=\"font-size:16px;line-height:1.65;margin:0\"><button class=\"card-btn\" sc-camel-on-click=\"{{ open12 }}\" style=\"display:block;min-width:340px;width:fit-content;margin:0 auto 14px;border:2px solid #1A6E8E;background:#ffffff;color:#1A6E8E;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:15px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:10px 32px;cursor:pointer;border-radius:2px;box-shadow:0 2px 6px rgba(0,48,57,.15);text-align:center\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">Card 12 · Draft B {{ stat12 }}<\u002Fbutton><span style=\"{{ insBlockStyle }}\">{{ docPro12 }}<\u002Fspan><\u002Fp>\n      <\u002Farticle>\n      <\u002Fsc-if>\n    <\u002Fmain>\n\n    <aside class=\"card-aside\" data-screen-label=\"Card index\" style=\"position:sticky;top:32px\">\n      <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:16px;letter-spacing:.06em;text-transform:uppercase;margin:0 0 4px\">Card index<\u002Fh3>\n      <p style=\"font-size:13px;color:#5a5f5e;margin:0 0 16px;font-style:italic\">All twelve cards, in package order.<\u002Fp>\n      <div style=\"display:flex;flex-direction:column\">\n        <sc-for list=\"{{ railCards }}\" as=\"c\" hint-placeholder-count=\"12\">\n          <button sc-camel-on-click=\"{{ c.open }}\" style=\"display:flex;align-items:baseline;gap:10px;padding:10px 4px;border:none;border-bottom:1px solid #dde4e1;background:transparent;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:14px;line-height:1.35;text-align:left;cursor:pointer;color:#000300\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">\n            <span style=\"color:#1A6E8E;font-variant-numeric:tabular-nums;min-width:18px\">{{ c.id }}<\u002Fspan>\n            <span style=\"flex:1\">{{ c.title }}<\u002Fspan>\n            <span style=\"font-style:italic;font-size:12px;color:#5a5f5e;white-space:nowrap\">{{ c.statusLabel }}<\u002Fspan>\n          <\u002Fbutton>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Faside>\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<sc-if value=\"{{ hasCard }}\" hint-placeholder-val=\"{{ false }}\">\n  <div class=\"dlg-wrap\" sc-camel-on-click=\"{{ close }}\" style=\"position:fixed;inset:0;background:rgba(32,30,29,.45);z-index:50;display:flex;align-items:flex-start;justify-content:center;padding:5vh 24px;overflow-y:auto\">\n    <div class=\"dlg\" sc-camel-on-click=\"{{ stop }}\" role=\"dialog\" aria-modal=\"true\" style=\"background:#ffffff;max-width:900px;width:100%;box-shadow:0 24px 48px rgba(0,48,57,.28);padding:44px 52px 52px;border-radius:2px\">\n      <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:16px;border-top:3px solid #000300;border-bottom:1px solid #000300;padding:8px 0;margin-bottom:24px\">\n        <span style=\"font-size:12px;letter-spacing:.1em;text-transform:uppercase\">Amendment card {{ card.id }} of 12 · {{ card.instrument }}<\u002Fspan>\n        <button sc-camel-on-click=\"{{ close }}\" style=\"border:none;background:transparent;font-family:'Montserrat', 'Proxima Nova', Helvetica, sans-serif;font-size:14px;color:#1A6E8E;cursor:pointer;padding:2px 6px\" style-hover=\"background:#eaf1f8\" style-focus=\"outline:2px solid #1A6E8E;outline-offset:2px\">Close ✕<\u002Fbutton>\n      <\u002Fdiv>\n\n      <h2 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:34px;line-height:1.1;margin:0 0 14px\">{{ card.title }}<\u002Fh2>\n      <p style=\"font-family:'Montserrat', sans-serif;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#1A6E8E;margin:0 0 16px\">{{ cardTheme }}<\u002Fp>\n      <div style=\"display:flex;align-items:center;gap:12px;margin:0 0 24px;background:#f4f6f7;padding:12px 16px;border-radius:2px\">\n        <label for=\"reviewer-name\" style=\"font-family:'Montserrat', sans-serif;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#5a5f5e;white-space:nowrap\">Reviewing as<\u002Flabel>\n        <input id=\"reviewer-name\" value=\"{{ reviewerName }}\" sc-camel-on-change=\"{{ setReviewer }}\" placeholder=\"Your name\" style=\"flex:1;border:1px solid #c9d3d1;border-radius:2px;padding:8px 12px;font-family:'Montserrat', sans-serif;font-size:14px;background:#ffffff\">\n      <\u002Fdiv>\n      <p style=\"font-size:19px;line-height:1.5;font-style:italic;margin:0 0 28px;max-width:60ch\">{{ card.sentence }}<\u002Fp>\n\n      <div class=\"dlg-grid\" style=\"display:grid;grid-template-columns:1fr 1fr;gap:32px;margin-bottom:36px\">\n        <div>\n          <h4 style=\"font-size:12px;letter-spacing:.12em;text-transform:uppercase;margin:0 0 8px;color:#B01116\">Today<\u002Fh4>\n          <p style=\"font-size:15px;line-height:1.6;margin:0\">{{ card.today }}<\u002Fp>\n        <\u002Fdiv>\n        <div>\n          <h4 style=\"font-size:12px;letter-spacing:.12em;text-transform:uppercase;margin:0 0 8px;color:#08473D\">After this amendment<\u002Fh4>\n          <p style=\"font-size:15px;line-height:1.6;margin:0\">{{ card.after }}<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div style=\"margin:0 0 36px\">\n        <p style=\"font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#5a5f5e;margin:0 0 8px\">Potential Consequences if Policy Stays the Same:<\u002Fp>\n        <p style=\"font-size:14px;line-height:1.55;margin:0\">{{ card.five.consequence }}<\u002Fp>\n      <\u002Fdiv>\n\n      <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:22px;margin:0 0 6px\">Examples of Policy Drafting Edits<\u002Fh3>\n      <p style=\"font-size:14px;color:#5a5f5e;margin:0 0 20px;font-style:italic\">The proposed text is complete and needs to be reviewed by a human prior to adoption.<\u002Fp>\n      <div class=\"dlg-grid\" style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:14px 32px;font-size:14px;line-height:1.5;margin-bottom:24px\">\n        <div><span style=\"display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#5a5f5e\">Where in the document<\u002Fspan>{{ card.provision }}<\u002Fdiv>\n        <div><span style=\"display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#5a5f5e\">Change type<\u002Fspan>{{ card.changeType }}<\u002Fdiv>\n      <\u002Fdiv>\n      <sc-for list=\"{{ cardRedlines }}\" as=\"r\" hint-placeholder-count=\"1\">\n        <div class=\"dlg-grid\" style=\"display:grid;grid-template-columns:1fr 1fr;gap:0 32px;margin-bottom:28px\">\n          <div>\n            <p style=\"font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#B01116;margin:0 0 6px\">Current text — remove<\u002Fp>\n            <p style=\"font-size:14.5px;line-height:1.6;margin:0;color:#5a5f5e\">{{ r.cur }}<\u002Fp>\n          <\u002Fdiv>\n          <div>\n            <p style=\"font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#08473D;margin:0 0 6px\">Proposed text — add <span style=\"color:#5a5f5e;text-transform:none;letter-spacing:0;font-weight:400\">(editable)<\u002Fspan><\u002Fp>\n            <textarea value=\"{{ r.proText }}\" sc-camel-on-change=\"{{ r.editPro }}\" rows=\"{{ r.rows }}\" style=\"width:100%;box-sizing:border-box;font-family:inherit;font-size:14.5px;line-height:1.6;border:1px solid #c9d3d1;border-radius:2px;padding:10px 12px;background:#fbfdfb;color:#000300;resize:vertical\"><\u002Ftextarea>\n            <sc-if value=\"{{ r.dirty }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"display:flex;gap:10px;align-items:center;margin:8px 0 0\">\n                <button class=\"btn btn-primary\" sc-camel-on-click=\"{{ r.savePro }}\" style=\"padding:6px 18px;font-size:13px\">Submit edit<\u002Fbutton>\n                <button class=\"btn btn-secondary\" sc-camel-on-click=\"{{ r.cancelPro }}\" style=\"padding:6px 18px;font-size:13px\">Discard<\u002Fbutton>\n                <span style=\"font-size:12px;font-style:italic;color:#B01116\">Unsaved changes<\u002Fspan>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n            <sc-if value=\"{{ r.edited }}\" hint-placeholder-val=\"{{ false }}\">\n              <p style=\"font-size:12px;font-style:italic;color:#5a5f5e;margin:6px 0 0\">Edited by {{ r.editedBy }} · {{ r.editedAt }} <button sc-camel-on-click=\"{{ r.resetPro }}\" style=\"border:none;background:transparent;font-family:'Montserrat', sans-serif;font-size:12px;color:#1A6E8E;cursor:pointer;text-decoration:underline;padding:0;margin-left:6px\">restore original<\u002Fbutton><\u002Fp>\n            <\u002Fsc-if>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-for>\n      <sc-if value=\"{{ hasNote }}\" hint-placeholder-val=\"{{ false }}\">\n        <p style=\"font-size:14px;line-height:1.6;font-style:italic;margin:0 0 32px\"><strong>Note for the drafter:<\u002Fstrong> {{ cardNote }}<\u002Fp>\n      <\u002Fsc-if>\n\n      <h3 style=\"font-family:'Source Serif 4', Georgia, serif;font-size:22px;margin:0 0 14px\">Technical Notes<\u002Fh3>\n      <div class=\"dlg-grid\" style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:14px 32px;font-size:14px;line-height:1.5;margin-bottom:36px\">\n        <div><span style=\"display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#5a5f5e\">Accountable owner<\u002Fspan>{{ card.owner }}<\u002Fdiv>\n        <div><span style=\"display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#5a5f5e\">Finding<\u002Fspan>{{ card.finding }}<\u002Fdiv>\n      <\u002Fdiv>\n\n\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsc-if>\n\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;defaultInstrument&quot;: {&quot;editor&quot;: &quot;enum&quot;, &quot;options&quot;: [&quot;ps&quot;, &quot;ss&quot;], &quot;default&quot;: &quot;ss&quot;, &quot;tsType&quot;: &quot;'ps'|'ss'&quot;, &quot;section&quot;: &quot;Behavior&quot;}}\">\nclass Component extends DCLogic {\n  state = { doc: null, view: 'redline', openId: null, statuses: {}, cards: [], edits: {}, reviewer: '' };\n  componentDidMount() {\n    let st = {};\n    try { st = JSON.parse(localStorage.getItem('gta-policy-cards-status') || '{}'); } catch (e) {}\n    try { this.setState({ edits: JSON.parse(localStorage.getItem('gta-policy-edits') || '{}'), reviewer: localStorage.getItem('gta-reviewer') || '' }); } catch (e) {}\n    const load = () => {\n      if (window.GTA_CARDS) { this.setState({ cards: window.GTA_CARDS, statuses: st }); }\n      else { setTimeout(load, 60); }\n    };\n    load();\n    this._esc = (e) => { if (e.key === 'Escape') this.setState({ openId: null }); };\n    window.addEventListener('keydown', this._esc);\n  }\n  componentWillUnmount() { window.removeEventListener('keydown', this._esc); }\n  label(s) { return { approve: 'Approved', changes: 'Approved with changes', defer: 'Deferred', reject: 'Rejected' }[s] || ''; }\n  decide(k) {\n    const id = this.state.openId;\n    if (!id) return;\n    const statuses = { ...this.state.statuses, [id]: k };\n    try { localStorage.setItem('gta-policy-cards-status', JSON.stringify(statuses)); } catch (e) {}\n    this.setState({ statuses });\n  }\n  clearDecision() {\n    const statuses = { ...this.state.statuses };\n    delete statuses[this.state.openId];\n    try { localStorage.setItem('gta-policy-cards-status', JSON.stringify(statuses)); } catch (e) {}\n    this.setState({ statuses });\n  }\n  fmtBlock(text, meta) {\n    const parts = [];\n    (text || '').split('\\n').map(l => l.trim()).filter(Boolean).forEach((line, i) => {\n      let label = line.match(/^(\\([a-z0-9ivx]{1,4}\\)\\s[^.:]{1,62}[.:])\\s/) || line.match(/^(\\([a-z0-9ivx]{1,4}\\))\\s/) || line.match(/^([A-Z][^.:]{1,50}:)\\s/);\n      if (i > 0) parts.push('\\n\\n');\n      if (label) {\n        parts.push(React.createElement('strong', { key: 'b' + i }, label[1]));\n        parts.push(line.slice(label[1].length));\n      } else parts.push(line);\n    });\n    if (meta) parts.push(React.createElement('em', { key: 'meta', style: { display: 'block', marginTop: '14px', fontSize: '13px', color: '#5a5f5e' } }, '— edited by ' + (meta.by || 'unnamed reviewer') + ', ' + meta.at));\n    return parts;\n  }\n  saveEdit(cardId, i, text, original) {\n    const edits = { ...(this.state.edits || {}) };\n    const forCard = { ...(edits[cardId] || {}) };\n    if (text === null || text === original) { delete forCard[i]; } else {\n      forCard[i] = { text, by: this.state.reviewer || '', at: new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) };\n    }\n    if (Object.keys(forCard).length) edits[cardId] = forCard; else delete edits[cardId];\n    this.setState({ edits });\n    try { localStorage.setItem('gta-policy-edits', JSON.stringify(edits)); } catch (e) {}\n  }\n  renderVals() {\n    const doc = this.state.doc || this.props.defaultInstrument || 'ss';\n    const view = this.state.view;\n    const rl = view === 'redline';\n    const cards = this.state.cards;\n    const card = cards.find(c => c.id === this.state.openId) || null;\n    const ins = rl ? { color: '#08473D' } : {};\n    const vals = {\n      isPS: doc === 'ps', isSS: doc === 'ss',\n      psCls: doc === 'ps' ? 'btn btn-primary' : 'btn btn-secondary',\n      ssCls: doc === 'ss' ? 'btn btn-primary' : 'btn btn-secondary',\n      rlCls: rl ? 'btn btn-primary' : 'btn btn-secondary',\n      clCls: rl ? 'btn btn-secondary' : 'btn btn-primary',\n      cardTheme: ({1:'Scope & Definitions',2:'Scope & Definitions',3:'Transparency & Resident Rights',4:'Records & Data Protection',5:'Vendors & Contracts',6:'Human Oversight & Testing',7:'Agentic AI Safeguards',8:'Human Oversight & Testing',9:'Records & Data Protection',10:'Transparency & Resident Rights',11:'Transparency & Resident Rights',12:'Agentic AI Safeguards'})[this.state.openId] || '',\n      showPS: () => this.setState({ doc: 'ps' }),\n      showSS: () => this.setState({ doc: 'ss' }),\n      showRedline: () => this.setState({ view: 'redline' }),\n      showClean: () => this.setState({ view: 'clean' }),\n      delStyle: rl ? { textDecoration: 'line-through', textDecorationColor: '#B01116', color: '#B01116' } : { display: 'none' },\n      insStyle: rl ? { ...ins, background: '#eaf3ec', boxShadow: '0 0 0 3px #eaf3ec', borderBottom: '2px solid #08473D', lineHeight: 1.75 } : {},\n      insBlockStyle: rl ? { ...ins, whiteSpace: 'pre-line', display: 'block', background: '#eaf3ec', borderLeft: '4px solid #08473D', padding: '24px 28px', margin: '16px 0', lineHeight: 1.85 } : { whiteSpace: 'pre-line', display: 'block', lineHeight: 1.85, margin: '12px 0' },\n      railCards: cards.map(c => ({ id: c.id, title: c.title, statusLabel: '', open: () => this.setState({ openId: c.id, doc: c.doc }) })),\n      hasCard: !!card,\n      card,\n      reviewerName: this.state.reviewer || '',\n      setReviewer: (e) => { const reviewer = e.target.value; this.setState({ reviewer }); try { localStorage.setItem('gta-reviewer', reviewer); } catch (err) {} },\n      cardRedlines: card ? card.redlines.map((r, i) => {\n        const edit = ((this.state.edits || {})[card.id] || {})[i];\n        const p = this.state.pending;\n        const isPending = p && p.cardId === card.id && p.i === i;\n        const savedText = edit ? edit.text : r.pro;\n        const proText = isPending ? p.text : savedText;\n        return {\n          cur: r.cur, proText,\n          rows: Math.max(3, Math.ceil(proText.length / 90)),\n          dirty: isPending && p.text !== savedText,\n          edited: !!edit, editedBy: edit ? (edit.by || 'Unnamed reviewer') : '', editedAt: edit ? edit.at : '',\n          editPro: (e) => this.setState({ pending: { cardId: card.id, i, text: e.target.value } }),\n          savePro: () => { if (this.state.pending) this.saveEdit(card.id, i, this.state.pending.text, r.pro); this.setState({ pending: null }); },\n          cancelPro: () => this.setState({ pending: null }),\n   